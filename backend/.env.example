# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- MongoDB ----
# Local:  mongodb://127.0.0.1:27017/mini-social-media
# Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/mini-social-media?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/mini-social-media

# ---- Auth ----
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_of_48_plus_characters
JWT_EXPIRES_IN=7d

# ---- Optional ----
# Comma-separated list of frontend origins allowed to call the API from a DIFFERENT domain.
# Not needed when the backend serves the frontend itself (default).
CORS_ORIGIN=
# Set to false if you host the frontend separately (Netlify, Vercel static, etc.)
SERVE_FRONTEND=true
# Number of reverse proxies in front of the app (1 on Render/Railway/Heroku/Nginx). Needed for correct rate limiting.
TRUST_PROXY=0
